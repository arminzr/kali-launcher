widget "updates" {
  page: 4
  order: 2
  size: 3x3
  minSize: 2x2

  // Simulates the upgrade (apt-get -s changes nothing and takes no lock), so the real
  // state stays untouched.
  source pending = cmd("""
    apt-get -s dist-upgrade >/dev/null 2>&1 || { echo error; exit; }
    apt-get -s dist-upgrade 2>/dev/null | grep '^Inst ' | awk '{print $2}'
  """) every 1h timeout 300s
  let failed = pending == "error"
  let list = pending == null || failed ? null : lines(pending).filter(l => l != "").map(l => words(l)[0])

  onTap: terminal("apt-get update && apt-get full-upgrade", "updates")

  Column {
    gap: 2
    Text { text: "updates"; style: muted }
    Text {
      text: failed ? "offline" : list == null ? "…" : "${len(list)}"
      style: title
      color: failed || list == null ? muted : len(list) > 0 ? yellow : green
    }
    if list != null {
      Text { text: len(list) == 0 ? "up to date" : join(list.take(4), " "); style: small; maxLines: 2 }
    }
  }
}
